    },
    {
      "groupId": "audio-tags",
      "id": "audio-tags-dolbyatmos",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/dolby-atmos.png",
      "isEnabled": true,
      "name": "ATMOS",
      "pattern": "(?i)\\batmos\\b",
      "tagColor": "#CCBBD6EF",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "audio-tags",
      "id": "audio-tags-dolbytruehd",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/dolby-truehd.png",
      "isEnabled": true,
      "name": "TRUEHD",
      "pattern": "(?i)^(?!.*\\batmos\\b).*\\btruehd\\b",
      "tagColor": "#CCFFC000",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "audio-tags",
      "id": "audio-tags-dolbydigitalplus",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/dolby-digitalplus.png",
      "isEnabled": true,
      "name": "DOLBY DIGITAL+",
      "pattern": "(?si)\\A(?![\\s\\S]*\\b(?:atmos|truehd)\\b)[\\s\\S]*\\b(?:ddp(?:[.\\s]?\\d(?:\\.\\d)?)?|dd\\+(?:[.\\s]?\\d(?:\\.\\d)?)?|e-?ac-?3|dolby[.\\s]?digital[.\\s]?plus)\\b",
      "tagColor": "#CCC0C0C0",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "audio-tags",
      "id": "audio-tags-dolbydigital",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/dolby-digital.png",
      "isEnabled": true,
      "name": "DOLBY DIGITAL",
      "pattern": "(?si)\\A(?![\\s\\S]*\\b(?:atmos|truehd|ddp(?:[.\\s]?\\d(?:\\.\\d)?)?|dd\\+(?:[.\\s]?\\d(?:\\.\\d)?)?|e-?ac-?3|dolby[.\\s]?digital[.\\s]?plus)\\b)[\\s\\S]*\\b(?:dd(?:[.\\s]?\\d(?:\\.\\d)?)?|ac-?3|dolby[.\\s]?digital)\\b",
      "tagColor": "#CCB08D57",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "audio-tags",
      "id": "audio-tags-dtsx",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/dtsx.png",
      "isEnabled": true,
      "name": "DTS-X",
      "pattern": "(?i)(?=.*\\b(?:dts[-_.: ]?x7?)\\b(?![-_. ]?(?:26[456])))(?!.*\\bDTS[ .]?[1-9]\\b)(?!.*\\bDD[^a-z+]\\b)(?!.*\\b(?:ac-?3)\\b)(?!.*\\bDD[P+]\\b)(?!.*\\b(?:e[-_. ]?ac-?3)\\b)(?!.*\\bTrue[ .-]?HD\\b)(?!.*\\bATMOS(?:\\b|\\d)\\b)(?!.*\\bFLAC\\b)(?!.*\\bAAC\\b)(?!.*\\b(?:l?)PCM\\b)",
      "tagColor": "#CCBBD6EF",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "audio-tags",
      "id": "audio-tags-dtshdma",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/dtshdma.png",
      "isEnabled": true,
      "name": "DTS-HD MA",
      "pattern": "(?i)(?=.*\\b(?:dts[-_. ]?(?:ma|hd(?:[-_. ]?ma)?|xll))(?:\\b|\\d))(?!.*\\b(?:True[ .-]?HD|ATMOS)(?:\\b|\\d))(?!.*\\bDD[P+]|(?:e[-_. ]?ac-?3)\\b)(?!.*\\bDD[^a-z+]|(?<!e-)\\b(?:ac-?3)\\b)(?!.*\\b(?:dts[-_.: ]?x7?)\\b(?![-_. ]?(?:26[456])))(?!.*\\bFLAC(?:\\b|\\d))(?!.*\\bAAC(?:\\b|\\d))(?!.*\\b(?:l?)PCM(?:\\b|\\d))(?!.*dts[-. ]?(?:es|(?:hd[. ]?)?(?:hr|hi)))",
      "tagColor": "#CCFFC000",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "audio-tags",
      "id": "audio-tags-dtshd",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/dtshd.png",
      "isEnabled": true,
      "name": "DTS-HD",
      "pattern": "(?i)\\bdts[ .\\-_]?hd(?![ .\\-_]?ma)\\b",
      "tagColor": "#CCC0C0C0",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "audio-tags",
      "id": "audio-tags-dts",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/dts.png",
      "isEnabled": true,
      "name": "DTS",
      "pattern": "(?i)^(?=.*\\bDTS(?:\\b|\\d))(?!.*\\b(?:dts[-_. ]?(?:ma|hd(?:[-_. ]?ma)?|xll))(?:\\b|\\d))(?!.*dts[-. ]?(?:es|(?:hd[. ]?)?(?:hr|hi)))(?!.*(?:\\bDD[P+]|(?:\\be[-_. ]?ac-?3\\b)))(?!.*(?:True[ .-]?HD|\\bATMOS(?:\\b|\\d)))(?!.*(?:\\bDD[^a-z+]|(?<!e-)\\b(?:ac-?3)\\b))(?!.*\\b(?:dts[-_.: ]?x7?)\\b(?![-_. ]?(?:26[456])))(?!.*\\bFLAC(?:\\b|\\d))(?!.*\\bAAC(?:\\b|\\d))(?!.*\\b(?:l?)PCM(?:\\b|\\d)).*$",
      "tagColor": "#CCB08D57",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
