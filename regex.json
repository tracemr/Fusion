      "pattern": "(?i)\\bimax[\\s._-]?enhanced\\b",
      "tagColor": "#007AFF",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "special-tags",
      "id": "special-tags-seadex",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/seadex.png",
