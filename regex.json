{
  "filters": [
    {
      "groupId": "source",
      "id": "source-remux",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/source-remux-large.png",
      "isEnabled": true,
      "name": "REMUX",
      "pattern": "(?i)(?<![a-z])remux(?![a-z])",
      "tagColor": "#00FFFFFF",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "source",
      "id": "source-bluray",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/source-bluray-large.png",
      "isEnabled": true,
      "name": "BLU-RAY",
      "pattern": "(?i)^(?=.*(?:(?:BluRay|Blu-Ray|HD-?DVD|BDMux|(?<=[-_. (\\[])BD(?=[-_. )\\]])|UHD|4K|bd(?:720|1080|2160)|DVD|DVDRip|NTSC|PAL|xvidvd)))(?!.*(?:(?:WEB[-_. ]DL(?:mux)?|WEBDL|AmazonHD|AmazonSD|iTunesHD|MaxdomeHD|NetflixU?HD|WebHD|HBOMaxHD|DisneyHD|[. ]WEB[. ](?:[xh][ .]?26[45]|AVC|HEVC|DDP?[ .]?5[. ]1)|(?:720|1080|2160)p[-. ]WEB[-. ]|[-. ]WEB[-. ](?:720|1080|2160)p|(?:AMZN|NF|DP)[. -]WEB[. -](?!Rip)|WebRip|Web-Rip|WEBMux|\\[WEB\\]|[\\(\\[]WEB[ .])))(?!.*(?:(?:[_. ]|\\d{4}p-|\\bHybrid-)(?:(?:BD|UHD)[-_. ]?)?Remux\\b|(?:(?:BD|UHD)[-_. ]?)?Remux[_. ]\\d{4}p)).*$",
      "tagColor": "#00FFFFFF",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "source",
      "id": "source-web",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/source-web-large.png",
      "isEnabled": true,
      "name": "WEB",
      "pattern": "(?i)^(?=.*(?<![a-z])(?:web[-_. ]?dl(?:rip|mux)?|web[-_. ]?rip|web[-_. ]?hd|web(?![a-z])|amazonhd|ituneshd|maxdomehd|netflixu?hd|hbomaxhd|disneyhd))(?!.*(?<![a-z])remux(?![a-z])).*$",
      "tagColor": "#00FFFFFF",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "resolution",
      "id": "resolution-2160p",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/4k.png",
      "isEnabled": true,
      "name": "2160p",
      "pattern": "(?i)\\b(?:2160p?|4k|uhd|ultra[ ._-]?hd)\\b(?!(?:.*?\\b(?:1080p?|720p?|fhd|full[ ._-]?hd)\\b))",
      "tagColor": "#CCBBD6EF",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "resolution",
      "id": "resolution-1440p",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/2k.png",
      "isEnabled": true,
      "name": "1440p",
      "pattern": "(?i)\\b(?:1440[pi]?|2k|2560\\s?x\\s?1440)\\b",
      "tagColor": "#CCFFC000",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "resolution",
      "id": "resolution-1080p",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/1080p-full-hd.png",
      "isEnabled": true,
      "name": "1080p",
      "pattern": "(?i)\\b(?:1080p?|fhd|full[ ._-]?hd)\\b",
      "tagColor": "#CCC0C0C0",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "resolution",
      "id": "resolution-720p",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/720p-hd.png",
      "isEnabled": true,
      "name": "720p",
      "pattern": "(?i)\\b720p?\\b",
      "tagColor": "#CCB08D57",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "dynamic-range",
      "id": "dynamic-range-dolbyvision",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/dolby-vision.png",
      "isEnabled": true,
      "name": "Dolby Vision",
      "pattern": "(?i)\\b(?:dv|dovi|dolby[ ._-]?vision)\\b",
      "tagColor": "#CCBBD6EF",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "dynamic-range",
      "id": "dynamic-range-hdr10plus",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/hdr10-plus.png",
      "isEnabled": true,
      "name": "HDR10+",
      "pattern": "(?si)\\A(?=[\\s\\S]*\\b(?:dolby\\.?vision|dovi|dv)\\b)[\\s\\S]*\\bhdr10(?:plus\\b|\\+)",
      "tagColor": "#CCBBD6EF",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "dynamic-range",
      "id": "dynamic-range-hdr10plus-2",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/hdr10-plus-2.png",
      "isEnabled": true,
      "name": "HDR10+ (No Dolby Vision)",
      "pattern": "(?si)\\A(?![\\s\\S]*\\b(?:dolby\\.?vision|dovi|dv)\\b)[\\s\\S]*\\bhdr10(?:plus\\b|\\+)",
      "tagColor": "#CCFFC000",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "dynamic-range",
      "id": "dynamic-range-hdr10",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/hdr10.png",
      "isEnabled": true,
      "name": "HDR10",
      "pattern": "(?si)\\A(?=[\\s\\S]*\\b(?:dolby\\.?vision|dovi|dv)\\b)[\\s\\S]*\\bhdr10\\b(?!(?:plus|\\+))",
      "tagColor": "#CCFFC000",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "dynamic-range",
      "id": "dynamic-range-hdr10-2",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/hdr10-2.png",
      "isEnabled": true,
      "name": "HDR10 (No Dolby Vision)",
      "pattern": "(?si)\\A(?![\\s\\S]*\\b(?:dolby\\.?vision|dovi|dv)\\b)[\\s\\S]*\\bhdr10\\b(?!(?:plus|\\+))",
      "tagColor": "#CCC0C0C0",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "dynamic-range",
      "id": "dynamic-range-hdr",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/hdr.png",
      "isEnabled": true,
      "name": "HDR",
      "pattern": "(?si)\\A(?![\\s\\S]*\\b(?:dv|dovi|dolby[ ._-]?vision)\\b)(?![\\s\\S]*\\bhdr\\s*10\\s*(?:\\+|plus|p)\\b)(?![\\s\\S]*\\bhdr\\s*10\\b)(?=[\\s\\S]*\\bhdr\\b)[\\s\\S]*",
      "tagColor": "#CCC0C0C0",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "dynamic-range",
      "id": "dynamic-range-sdr",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/sdr.png",
      "isEnabled": true,
      "name": "SDR",
      "pattern": "(?si)\\A(?=[\\s\\S]*(?:\\.(?:mkv|mp4|avi|mov|m4v|ts)\\b|\\b(?:x264|x265|xvid|h[ ._-]?264|h[ ._-]?265|hevc|avc|web[-_. ]?dl|webrip|blu[-_. ]?ray|bd[-_. ]?remux|bdremux|remux|bdrip|bdmux|dvd|dvdrip|hdtv|uhd|4k)\\b))(?![\\s\\S]*(?:^|[^A-Za-z0-9])(?:dovi|dv|dolby[ ._-]?vision|hdr10(?:\\+|plus|p)?|hdr[ ._-]?10[ ._-]?(?:\\+|plus|p)?|hdr|hlg)(?=$|[^A-Za-z0-9]))[\\s\\S]*$",
      "tagColor": "#CCB08D57",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "special-tags",
      "id": "special-tags-bluray",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/bluray.png",
      "isEnabled": false,
      "name": "Blu-Ray",
      "pattern": "(?i)\\b(?:blu[- ]?ray|bd[- ]?rip|br[- ]?rip|bdr)\\b(?!.*remux)",
      "tagColor": "#5AC8FA",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "special-tags",
      "id": "special-tags-imax",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/imax.png",
      "isEnabled": true,
      "name": "IMAX",
      "pattern": "(?i)\\bimax\\b(?![\\s._-]?enhanced)",
      "tagColor": "#007AFF",
      "tagStyle": "filled",
      "type": "filter"
    },
    {
      "groupId": "special-tags",
      "id": "special-tags-imax-enhanced",
      "imageURL": "https://raw.githubusercontent.com/tracemr/Fusion/refs/heads/main/Regex/imax-enhanced.png",
      "isEnabled": true,
